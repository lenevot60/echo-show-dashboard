<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd: elke 10 minuten de widget bijwerken. Vervang de paden, kopieer naar ~/Library/LaunchAgents/ en laad met:
     launchctl load ~/Library/LaunchAgents/nl.dashboard.push.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>nl.dashboard.push</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/PAD/NAAR/Echo Show Dashboard/tools/push.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/PAD/NAAR/Echo Show Dashboard</string>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/nl.dashboard.push.log</string>
  <key>StandardErrorPath</key><string>/tmp/nl.dashboard.push.log</string>
</dict>
</plist>
