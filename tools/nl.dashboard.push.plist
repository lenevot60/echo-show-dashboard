<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd: elke 10 minuten versturen (gist voor het volledige scherm, data store voor de widget). Vervang de paden en
     /Users/JIJ, kopieer naar ~/Library/LaunchAgents/ en laad met:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/nl.dashboard.push.plist
     node-ical vraagt Node 22 of nieuwer. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>nl.dashboard.push</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/PAD/NAAR/Echo Show Dashboard/tools/push.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/PAD/NAAR/Echo Show Dashboard</string>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/JIJ/Library/Logs/echo-show-dashboard.log</string>
  <key>StandardErrorPath</key><string>/Users/JIJ/Library/Logs/echo-show-dashboard.log</string>
</dict>
</plist>
