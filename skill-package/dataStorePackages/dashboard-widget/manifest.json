{
  "manifest": {
    "id": "dashboard-widget",
    "version": "1.0.0",
    "installStateChanges": "INFORM",
    "updateStateChanges": "INFORM",
    "presentationDefinitions": [{ "url": "presentations/default.tpl" }],
    "appliesTo": "${viewport.mode == 'HUB'}"
  },
  "packageVersion": "1.0",
  "packageType": "APL_PACKAGE",
  "publishingInformation": {
    "schemaVersion": "1.0",
    "locales": {
      "nl-NL": [
        {
          "targetViewport": "WIDGET_M",
          "metadata": {
            "name": "Mijn dashboard",
            "description": "Weer, je notities en een tegel naar je eigen webdashboard. Gegevens van je eigen backend.",
            "keywords": ["dashboard", "weer", "notities"],
            "iconUri": "https://VUL-IN.example.com/icon-450.png",
            "previews": ["https://VUL-IN.example.com/preview-328x552.png"]
          }
        }
      ],
      "en-GB": [
        {
          "targetViewport": "WIDGET_M",
          "metadata": {
            "name": "My dashboard",
            "description": "Weather, your notes and a tile to your own web dashboard. Data from your own backend.",
            "keywords": ["dashboard", "weather", "notes"],
            "iconUri": "https://VUL-IN.example.com/icon-450.png",
            "previews": ["https://VUL-IN.example.com/preview-328x552.png"]
          }
        }
      ]
    }
  }
}
