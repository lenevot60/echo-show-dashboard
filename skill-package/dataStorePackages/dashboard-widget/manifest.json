{
  "manifest": {
    "id": "dashboard-widget",
    "version": "1.1.0",
    "installStateChanges": "INFORM",
    "updateStateChanges": "INFORM",
    "presentationDefinitions": [
      {
        "url": "presentations/default.tpl"
      }
    ],
    "appliesTo": "${viewport.mode == 'HUB'}"
  },
  "packageVersion": "1.0",
  "packageType": "APL_PACKAGE",
  "publishingInformation": {
    "schemaVersion": "1.0",
    "locales": {
      "nl-NL": [
        {
          "targetViewport": "WIDGET_M",
          "metadata": {
            "name": "Mijn dashboard",
            "description": "Reistijd naar werk, weer en regen, je afspraken, taken en lopende Claude-chats. Gevuld vanaf je eigen Mac.",
            "keywords": [
              "dashboard",
              "reistijd",
              "weer",
              "agenda"
            ],
            "iconUri": "https://raw.githubusercontent.com/lenevot60/echo-show-dashboard/main/assets/icon-450.png",
            "previews": [
              "https://raw.githubusercontent.com/lenevot60/echo-show-dashboard/main/assets/preview-328x552.png"
            ]
          }
        }
      ],
      "en-GB": [
        {
          "targetViewport": "WIDGET_M",
          "metadata": {
            "name": "My dashboard",
            "description": "Travel time to work, weather and rain, your appointments, tasks and running Claude sessions. Filled from your own Mac.",
            "keywords": [
              "dashboard",
              "commute",
              "weather",
              "agenda"
            ],
            "iconUri": "https://raw.githubusercontent.com/lenevot60/echo-show-dashboard/main/assets/icon-450.png",
            "previews": [
              "https://raw.githubusercontent.com/lenevot60/echo-show-dashboard/main/assets/preview-328x552.png"
            ]
          }
        }
      ],
      "en-US": [
        {
          "targetViewport": "WIDGET_M",
          "metadata": {
            "name": "My dashboard",
            "description": "Travel time to work, weather and rain, your appointments, tasks and running Claude sessions. Filled from your own Mac.",
            "keywords": [
              "dashboard",
              "commute",
              "weather",
              "agenda"
            ],
            "iconUri": "https://raw.githubusercontent.com/lenevot60/echo-show-dashboard/main/assets/icon-450.png",
            "previews": [
              "https://raw.githubusercontent.com/lenevot60/echo-show-dashboard/main/assets/preview-328x552.png"
            ]
          }
        }
      ]
    }
  }
}
