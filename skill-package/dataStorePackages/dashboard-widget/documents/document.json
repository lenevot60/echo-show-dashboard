{
  "type": "APL",
  "version": "2024.3",
  "description": "Widget (WIDGET_M): travel time to work, departure advice, weather with rain for the next two hours, the next appointments, open tasks and the Claude sessions. All data from the device data store (namespace dashboard, key overzicht), filled from the Mac.",
  "extensions": [{ "name": "DataStore", "uri": "alexaext:datastore:10" }],
  "settings": {
    "DataStore": {
      "dataBindings": [{ "namespace": "dashboard", "key": "overzicht", "dataBindingName": "ds", "dataType": "OBJECT" }]
    }
  },
  "import": [{ "name": "alexa-layouts", "version": "1.7.0" }],
  "resources": [
    {
      "colors": {
        "vlak": "#FFFFFF",
        "inkt": "#14161C",
        "inkt2": "#5B6170",
        "inkt3": "#8A90A0",
        "donker": "#14161C",
        "opDonker": "#FFFFFF",
        "opDonker2": "#C5CBD6",
        "accent": "#FFC531",
        "accentInkt": "#14161C",
        "lijn": "#E6E7EB",
        "zacht": "#F2F3F5",
        "regen": "#4C8DD6",
        "vraag": "#B07A00"
      }
    }
  ],
  "layouts": {
    "Knop": {
      "parameters": [
        { "name": "tekst", "type": "string" },
        { "name": "primair", "type": "boolean", "default": false },
        { "name": "actie", "type": "any" }
      ],
      "items": [
        {
          "type": "TouchWrapper",
          "accessibilityLabel": "${tekst}",
          "onPress": "${actie}",
          "item": {
            "type": "Frame",
            "backgroundColor": "${primair ? '@accent' : '@zacht'}",
            "borderRadius": 999,
            "paddingLeft": 12,
            "paddingRight": 12,
            "paddingTop": 7,
            "paddingBottom": 7,
            "item": { "type": "Text", "text": "${tekst}", "fontSize": 13, "fontWeight": "700", "color": "@accentInkt", "maxLines": 1 }
          }
        }
      ]
    },
    "Rij": {
      "parameters": [
        { "name": "links", "type": "string" },
        { "name": "rechts", "type": "string" },
        { "name": "kleur", "type": "color", "default": "@inkt" }
      ],
      "items": [
        {
          "type": "Container",
          "direction": "row",
          "paddingTop": 6,
          "paddingBottom": 6,
          "items": [
            { "type": "Text", "text": "${links}", "width": 54, "fontSize": 14, "fontWeight": "700", "color": "@inkt", "maxLines": 1 },
            { "type": "Text", "text": "${rechts}", "grow": 1, "shrink": 1, "fontSize": 14, "color": "${kleur}", "maxLines": 1 }
          ]
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Frame",
        "width": "100%",
        "height": "100%",
        "backgroundColor": "@vlak",
        "borderRadius": 14,
        "item": {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "paddingLeft": 14,
          "paddingRight": 14,
          "paddingTop": 12,
          "paddingBottom": 12,
          "items": [
            {
              "type": "Container",
              "direction": "row",
              "alignItems": "baseline",
              "items": [
                { "type": "Text", "text": "${ds ? ds.titel : payload.start.titel}", "fontSize": 18, "fontWeight": "700", "color": "@inkt", "grow": 1, "maxLines": 1 },
                { "type": "Text", "text": "${ds ? ds.bijgewerktTekst : ''}", "fontSize": 12, "color": "@inkt3", "maxLines": 1 }
              ]
            },
            {
              "type": "Text",
              "display": "${ds ? 'none' : 'normal'}",
              "text": "${payload.start.tekst}",
              "fontSize": 14,
              "color": "@inkt2",
              "paddingTop": 10
            },
            {
              "type": "Frame",
              "display": "${ds && ds.route ? 'normal' : 'none'}",
              "backgroundColor": "@donker",
              "borderRadius": 14,
              "paddingLeft": 12,
              "paddingRight": 12,
              "paddingTop": 10,
              "paddingBottom": 10,
              "marginTop": 10,
              "item": {
                "type": "Container",
                "width": "100%",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "baseline",
                    "items": [
                      { "type": "Text", "text": "${ds.route.minuten}", "fontSize": 40, "fontWeight": "800", "color": "@opDonker" },
                      { "type": "Text", "text": "min", "fontSize": 16, "fontWeight": "700", "color": "@opDonker", "paddingLeft": 4 },
                      { "type": "Text", "text": "naar werk", "fontSize": 13, "color": "@opDonker2", "paddingLeft": 10, "grow": 1, "maxLines": 1 }
                    ]
                  },
                  {
                    "type": "Text",
                    "text": "${ds.route.via ? 'via ' + ds.route.via : ''}${ds.route.vertraging > 0 ? ' · +' + ds.route.vertraging + ' min file' : ' · geen file'}",
                    "fontSize": 13,
                    "color": "@opDonker2",
                    "maxLines": 1
                  }
                ]
              }
            },
            {
              "type": "Text",
              "display": "${ds && ds.vertrek ? 'normal' : 'none'}",
              "text": "${ds.vertrek.tekst}",
              "fontSize": 13,
              "fontWeight": "700",
              "color": "${ds.vertrek.teLaat ? '#B4232B' : '@vraag'}",
              "paddingTop": 6,
              "maxLines": 2
            },
            {
              "type": "Container",
              "display": "${ds && ds.weer ? 'normal' : 'none'}",
              "direction": "row",
              "alignItems": "center",
              "paddingTop": 8,
              "items": [
                { "type": "Text", "text": "${ds.weer.temperatuur}°", "fontSize": 30, "fontWeight": "700", "color": "@inkt" },
                {
                  "type": "Container",
                  "paddingLeft": 10,
                  "grow": 1,
                  "shrink": 1,
                  "items": [
                    { "type": "Text", "text": "${ds.weer.beschrijving}", "fontSize": 13, "color": "@inkt2", "maxLines": 1 },
                    { "type": "Text", "text": "${ds.regen ? ds.regen.samenvatting : ds.weer.plaats}", "fontSize": 12, "color": "@inkt3", "maxLines": 1 }
                  ]
                }
              ]
            },
            {
              "type": "Container",
              "display": "${ds && ds.regen ? 'normal' : 'none'}",
              "direction": "row",
              "alignItems": "end",
              "height": 22,
              "paddingTop": 4,
              "data": "${ds.regen.balken}",
              "items": [
                {
                  "type": "Frame",
                  "grow": 1,
                  "height": "${data > 0 ? Math.max(2, data * 0.18) : 1}",
                  "backgroundColor": "${data > 0 ? '@regen' : '@lijn'}",
                  "marginLeft": 1,
                  "marginRight": 1
                }
              ]
            },
            {
              "type": "Container",
              "display": "${ds && ds.aantalAgenda > 0 ? 'normal' : 'none'}",
              "paddingTop": 6,
              "data": "${ds.agenda}",
              "items": [
                {
                  "type": "Rij",
                  "display": "${index < 3 ? 'normal' : 'none'}",
                  "links": "${data.soort == 'afval' ? 'Afval' : data.tijd}",
                  "rechts": "${data.soort == 'afval' ? data.titel + ' (' + data.dag + ')' : data.titel}"
                }
              ]
            },
            {
              "type": "Container",
              "display": "${ds && ds.aantalTaken > 0 ? 'normal' : 'none'}",
              "data": "${ds.taken}",
              "items": [
                {
                  "type": "Rij",
                  "display": "${index < 2 ? 'normal' : 'none'}",
                  "links": "${index == 0 ? 'Taak' : ''}",
                  "rechts": "${data.titel}${data.wanneer ? ' · ' + data.wanneer : ''}",
                  "kleur": "${data.wanneer == 'te laat' ? '#B4232B' : '@inkt'}"
                }
              ]
            },
            {
              "type": "Rij",
              "display": "${ds && ds.claude && (ds.claude.bezig + ds.claude.wacht) > 0 ? 'normal' : 'none'}",
              "links": "Claude",
              "rechts": "${ds.claude.vragen > 0 ? ds.claude.vragen + ' wacht op antwoord · ' : ''}${ds.claude.bezig} bezig · ${ds.claude.wacht} wacht",
              "kleur": "${ds.claude.vragen > 0 ? '@vraag' : '@inkt2'}"
            },
            { "type": "Container", "grow": 1 },
            {
              "type": "Container",
              "display": "${ds ? 'normal' : 'none'}",
              "direction": "row",
              "items": [
                {
                  "type": "Knop",
                  "tekst": "Dashboard",
                  "primair": true,
                  "actie": [{ "type": "SendEvent", "arguments": ["openDashboard"], "flags": { "interactionMode": "STANDARD" } }]
                },
                { "type": "Container", "width": 8 },
                {
                  "type": "Knop",
                  "tekst": "Ververs",
                  "actie": [{ "type": "SendEvent", "arguments": ["refresh", "widget"], "flags": { "interactionMode": "INLINE" } }]
                },
                { "type": "Container", "width": 8, "display": "${ds && ds.web ? 'normal' : 'none'}" },
                {
                  "type": "Knop",
                  "display": "${ds && ds.web ? 'normal' : 'none'}",
                  "tekst": "${ds && ds.web ? ds.web.titel : ''}",
                  "actie": [{ "type": "OpenURL", "source": "${ds.web.url}" }]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
