{
  "type": "APL",
  "version": "2024.3",
  "description": "Widget (WIDGET_M) for the Echo Show: weather, notes and a tile to the own web dashboard. Data from the device data store (namespace dashboard, key overzicht); the static datasource only shows the start text.",
  "extensions": [{ "name": "DataStore", "uri": "alexaext:datastore:10" }],
  "settings": {
    "DataStore": {
      "dataBindings": [
        { "namespace": "dashboard", "key": "overzicht", "dataBindingName": "ds", "dataType": "OBJECT" }
      ]
    }
  },
  "import": [{ "name": "alexa-layouts", "version": "1.7.0" }],
  "resources": [
    {
      "colors": {
        "vlak": "#FFFFFF",
        "inkt": "#14161C",
        "inkt2": "#5B6170",
        "inkt3": "#8A90A0",
        "accent": "#F2B705",
        "accentInkt": "#14161C",
        "lijn": "#E6E7EB",
        "zacht": "#F5F6F8"
      },
      "dimensions": { "rand": 14, "pil": 999 }
    }
  ],
  "layouts": {
    "Knop": {
      "parameters": [
        { "name": "tekst", "type": "string" },
        { "name": "primair", "type": "boolean", "default": false },
        { "name": "actie", "type": "any" }
      ],
      "items": [
        {
          "type": "TouchWrapper",
          "accessibilityLabel": "${tekst}",
          "onPress": "${actie}",
          "item": {
            "type": "Frame",
            "backgroundColor": "${primair ? '@accent' : '@zacht'}",
            "borderRadius": "@pil",
            "paddingLeft": 12,
            "paddingRight": 12,
            "paddingTop": 7,
            "paddingBottom": 7,
            "item": {
              "type": "Text",
              "text": "${tekst}",
              "fontSize": 13,
              "fontWeight": "700",
              "color": "${primair ? '@accentInkt' : '@inkt'}",
              "maxLines": 1
            }
          }
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Frame",
        "width": "100%",
        "height": "100%",
        "backgroundColor": "@vlak",
        "borderRadius": "@rand",
        "item": {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "paddingLeft": 14,
          "paddingRight": 14,
          "paddingTop": 12,
          "paddingBottom": 12,
          "items": [
            {
              "type": "Container",
              "direction": "row",
              "alignItems": "baseline",
              "items": [
                {
                  "type": "Text",
                  "text": "${ds ? ds.titel : payload.start.titel}",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "color": "@inkt",
                  "grow": 1,
                  "maxLines": 1
                },
                {
                  "type": "Text",
                  "text": "${ds ? ds.bijgewerktTekst : ''}",
                  "fontSize": 12,
                  "color": "@inkt3",
                  "maxLines": 1
                }
              ]
            },
            {
              "type": "Text",
              "display": "${ds ? 'none' : 'normal'}",
              "text": "${payload.start.tekst}",
              "fontSize": 14,
              "color": "@inkt2",
              "paddingTop": 10
            },
            {
              "type": "Container",
              "display": "${ds && ds.weer ? 'normal' : 'none'}",
              "direction": "row",
              "alignItems": "center",
              "paddingTop": 10,
              "items": [
                {
                  "type": "Image",
                  "source": "${ds.weer.iconUrl}",
                  "width": 56,
                  "height": 56,
                  "scale": "best-fit"
                },
                {
                  "type": "Container",
                  "paddingLeft": 10,
                  "grow": 1,
                  "shrink": 1,
                  "items": [
                    {
                      "type": "Text",
                      "text": "${ds.weer.temperatuur}°",
                      "fontSize": 36,
                      "fontWeight": "700",
                      "color": "@inkt",
                      "maxLines": 1
                    },
                    {
                      "type": "Text",
                      "text": "${ds.weer.beschrijving}",
                      "fontSize": 13,
                      "color": "@inkt2",
                      "maxLines": 1
                    },
                    {
                      "type": "Text",
                      "text": "${ds.weer.plaats} · ${ds.weer.wind}",
                      "fontSize": 12,
                      "color": "@inkt3",
                      "maxLines": 1
                    }
                  ]
                }
              ]
            },
            {
              "type": "Container",
              "display": "${ds && ds.weer ? 'normal' : 'none'}",
              "direction": "row",
              "paddingTop": 8,
              "data": "${ds.weer.verwachting}",
              "items": [
                {
                  "type": "Container",
                  "grow": 1,
                  "alignItems": "center",
                  "items": [
                    { "type": "Text", "text": "${data.dag}", "fontSize": 12, "color": "@inkt3" },
                    { "type": "Text", "text": "${data.max}° / ${data.min}°", "fontSize": 13, "fontWeight": "700", "color": "@inkt" },
                    { "type": "Text", "text": "${data.regenkans}%", "fontSize": 12, "color": "@inkt2" }
                  ]
                }
              ]
            },
            {
              "type": "Text",
              "display": "${ds && ds.fout ? 'normal' : 'none'}",
              "text": "${ds.fout}",
              "fontSize": 12,
              "color": "@inkt3",
              "paddingTop": 8,
              "maxLines": 2
            },
            {
              "type": "Container",
              "display": "${ds && ds.aantalItems > 0 ? 'normal' : 'none'}",
              "paddingTop": 10,
              "data": "${ds.items}",
              "items": [
                {
                  "type": "Text",
                  "text": "• ${data.titel}",
                  "fontSize": 14,
                  "color": "@inkt",
                  "maxLines": 1,
                  "display": "${index < 3 ? 'normal' : 'none'}"
                }
              ]
            },
            { "type": "Container", "grow": 1 },
            {
              "type": "Container",
              "display": "${ds ? 'normal' : 'none'}",
              "direction": "row",
              "wrap": "wrap",
              "paddingTop": 10,
              "items": [
                {
                  "type": "Knop",
                  "tekst": "Dashboard",
                  "primair": true,
                  "actie": [
                    { "type": "SendEvent", "arguments": ["openDashboard"], "flags": { "interactionMode": "STANDARD" } }
                  ]
                },
                { "type": "Container", "width": 8 },
                {
                  "type": "Knop",
                  "tekst": "Ververs",
                  "actie": [
                    { "type": "SendEvent", "arguments": ["refresh", "widget"], "flags": { "interactionMode": "INLINE" } }
                  ]
                },
                { "type": "Container", "width": 8, "display": "${ds && ds.web ? 'normal' : 'none'}" },
                {
                  "type": "Knop",
                  "display": "${ds && ds.web ? 'normal' : 'none'}",
                  "tekst": "${ds && ds.web ? ds.web.titel : ''}",
                  "actie": [{ "type": "OpenURL", "source": "${ds.web.url}" }]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
