# Kopieer naar .env (gitignored). Nooit committen, nooit in de chat plakken.
ALEXA_CLIENT_ID=            # Developer Console > je skill > Tools > Permissions > Alexa Skill Messaging > Client Id
ALEXA_CLIENT_SECRET=        # idem, Client Secret
ALEXA_USER_ID=              # zeg tegen de Echo Show: "Alexa, vraag mijn dashboard om mijn gebruikers-id" (staat ook als kaart in de Alexa-app)
DATASTORE_ENDPOINT=https://api.eu.amazonalexa.com/v1/datastore/commands
